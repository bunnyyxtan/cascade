# ── Network ───────────────────────────────────────────────────────────────────
# "testnet" (Arc Testnet, chain ID 5042002) or "mainnet" (Arc Mainnet, chain ID 5042)
VITE_NETWORK=testnet

# ── Contract ──────────────────────────────────────────────────────────────────
# Deployed Cascade contract address
VITE_CASCADE_ADDRESS=0xa87371b1127d88df309313ddcaa43b6191fa9a57

# Block the contract was deployed at (speeds up initial event sync; optional but recommended)
VITE_CASCADE_DEPLOY_BLOCK=69056151

# keccak256 of the deployed runtime bytecode — required for startup config verification.
# Without this, all write operations are blocked ("unverified" status).
# Compute with: cast keccak $(cast code <address> --rpc-url <rpc>)
VITE_CASCADE_CODEHASH=0xdae313ed3e636b9ee2cc0067af1a501ad8128e031a2d23b5f2d5e78ae1cd8e29

# ── Arc Studio RPC proxy (Arc Studio sandbox only) ────────────────────────────
# These are injected automatically inside Arc Studio. Leave blank outside Arc Studio.
# Outside Arc Studio the app falls back to the public Arc RPC endpoint.
VITE_RPC_PROXY_BASE_URL=
VITE_RPC_PROXY_TOKEN=
VITE_RPC_PROXY_CHAINS=
