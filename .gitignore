# ── Node ────────────────────────────────────────────────────────────────────
node_modules/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
out/

# ── Test coverage ─────────────────────────────────────────────────────────────
coverage/

# ── Environment — never commit real values ───────────────────────────────────
.env
.env.*
!.env.example

# ── Arc Studio sandbox runtime files ─────────────────────────────────────────
# These are generated by the Arc Studio preview iframe and must never be committed.
console.jsonl
traces.jsonl
context/

# ── Foundry build artefacts ───────────────────────────────────────────────────
contracts/out/
contracts/cache/
cache/
broadcast/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── Arc Studio internal ───────────────────────────────────────────────────────
.arc-studio/

# ── Custom agent skills (Arc Studio workspace-local) ─────────────────────────
.agents/

# ── Arc Studio plan files (workspace-local, not source) ──────────────────────
arc-studio-plans/

# ── Vitest / Vite caches ──────────────────────────────────────────────────────
node_modules/.vitest-cache/
node_modules/.vite/

# ── Release archives ─────────────────────────────────────────────────────────
*.tar.gz
*.zip

# ── Vendored library CI (forge-std and other libs under lib/) ────────────────
# These workflow files belong to upstream projects, not Cascade CI.
lib/**/.github/workflows/
